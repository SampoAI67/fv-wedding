---
import { COUPLE, RSVP } from '../data/content';
---

<section class="rsvp" id="rsvp" aria-labelledby="rsvp-title">
  <div class="rsvp__glow" aria-hidden="true"></div>
  <div class="rsvp__letter parchment" data-reveal>
    <div class="rsvp__seal-top" aria-hidden="true">
      <svg viewBox="0 0 100 100"><use href="#waxSeal" /></svg>
    </div>
    <p class="kicker rsvp__chapter">{RSVP.chapter}</p>
    <h2 class="rsvp__title" id="rsvp-title">{RSVP.title}</h2>
    <p class="rsvp__intro">{RSVP.intro} Rispondi entro il <strong>{RSVP.deadline}</strong>.</p>

    <form class="rsvp__form" data-rsvp data-whatsapp={RSVP.whatsapp} data-couple={`${COUPLE.bride} e ${COUPLE.groom}`} novalidate>
      <label class="field">
        <span class="field__label">Nome e cognome</span>
        <input name="name" type="text" autocomplete="name" required />
      </label>

      <fieldset class="choice">
        <legend class="field__label">Risponderai alla chiamata?</legend>
        <label class="choice__opt">
          <input type="radio" name="coming" value="yes" required checked />
          <span><strong>Ci sarò!</strong><em>La Compagnia può contare su di me</em></span>
        </label>
        <label class="choice__opt">
          <input type="radio" name="coming" value="no" />
          <span><strong>Non potrò esserci</strong><em>Ma brinderò a voi da lontano</em></span>
        </label>
      </fieldset>

      <div class="field field--guests" data-guests>
        <span class="field__label" id="guests-label">Quanti siete, te compreso?</span>
        <div class="stepper" role="group" aria-labelledby="guests-label">
          <button type="button" data-step="-1" aria-label="Uno in meno">−</button>
          <output name="guests" aria-live="polite">1</output>
          <button type="button" data-step="1" aria-label="Uno in più">+</button>
        </div>
      </div>

      <label class="field">
        <span class="field__label">Allergie o intolleranze</span>
        <input name="diet" type="text" placeholder="Nessuna, mangio come un hobbit" />
      </label>

      <label class="field">
        <span class="field__label">Un messaggio per gli sposi</span>
        <textarea name="message" rows="3"></textarea>
      </label>

      <button class="btn btn--ink rsvp__send" type="submit">Invia il corvo</button>
      <p class="rsvp__error" role="alert" hidden>Scrivi il tuo nome, così gli sposi sapranno chi risponde.</p>
    </form>

    <div class="rsvp__done" hidden tabindex="-1">
      <p class="rsvp__done-title">Il corvo è partito!</p>
      <p class="rsvp__done-text" data-done-text></p>
      <div class="rsvp__stamp" aria-hidden="true">
        <svg viewBox="0 0 100 100"><use href="#waxSeal" /></svg>
      </div>
    </div>
  </div>

  <!-- the wax seal, drawn once and reused -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <radialGradient id="waxGrad" cx="38%" cy="32%" r="75%">
        <stop offset="0" stop-color="#b5a6de" />
        <stop offset="0.55" stop-color="#7d6bb3" />
        <stop offset="1" stop-color="#4a3b7a" />
      </radialGradient>
      <symbol id="waxSeal" viewBox="0 0 100 100">
        <path
          d="M50 4 C60 3 64 9 72 10 C80 12 86 14 89 22 C93 30 97 36 96 46 C95 56 99 62 95 70 C91 79 85 84 77 89 C69 94 61 97 51 96 C41 95 34 98 26 93 C18 88 10 84 7 75 C4 66 2 59 4 50 C6 41 3 34 8 26 C13 18 19 13 28 9 C36 6 41 5 50 4 Z"
          fill="url(#waxGrad)"
        />
        <circle cx="50" cy="50" r="31" fill="none" stroke="#3d3066" stroke-width="2" opacity="0.55" />
        <circle cx="50" cy="50" r="27" fill="none" stroke="#d6cdf0" stroke-width="0.8" opacity="0.5" />
        <circle cx="44" cy="52" r="11" fill="none" stroke="#3d3066" stroke-width="2.2" opacity="0.75" />
        <circle cx="56" cy="52" r="11" fill="none" stroke="#3d3066" stroke-width="2.2" opacity="0.75" />
        <text x="50" y="35" text-anchor="middle" font-family="Cinzel, serif" font-size="9" fill="#2f2452" opacity="0.8">F · V</text>
      </symbol>
    </defs>
  </svg>
</section>

<style>
  .rsvp {
    position: relative;
    padding: clamp(80px, 14vh, 140px) 12px clamp(80px, 12vh, 120px);
    background:
      radial-gradient(ellipse 70% 50% at 50% 0%, rgb(255 170 80 / 0.16), transparent 70%),
      linear-gradient(#1d150d, #141018 70%, #0e0e18);
    overflow: hidden;
  }

  .rsvp__letter {
    position: relative;
    width: min(620px, 100%);
    margin: 0 auto;
    padding: 64px clamp(20px, 5vw, 56px) 44px;
    border-radius: 3px;
  }

  .rsvp__seal-top {
    position: absolute;
    left: 50%;
    top: -38px;
    width: 76px;
    height: 76px;
    transform: translateX(-50%) rotate(-8deg);
    filter: drop-shadow(0 6px 8px rgb(20 10 30 / 0.45));
  }

  .rsvp__chapter {
    text-align: center;
    color: var(--lavender-deep);
    font-size: 0.66rem;
  }
  .rsvp__title {
    margin-top: 10px;
    text-align: center;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.7rem, 5vw, 2.5rem);
    line-height: 1.1;
  }
  .rsvp__intro {
    margin: 12px auto 0;
    max-width: 38ch;
    text-align: center;
    font-size: 1.15rem;
    color: var(--ink-soft);
  }
  .rsvp__intro strong {
    font-weight: 500;
    color: var(--ink);
  }

  .rsvp__form {
    display: grid;
    gap: 20px;
    margin-top: 30px;
  }

  .field {
    display: grid;
    gap: 6px;
  }
  .field__label {
    padding: 0;
    font-family: var(--display);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .field input,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 10px 12px;
    border: 0;
    border-bottom: 1.5px solid rgb(51 40 26 / 0.45);
    border-radius: 0;
    background: rgb(255 251 240 / 0.45);
    font-size: 1.15rem;
    color: var(--ink);
    transition:
      border-color 0.3s,
      background-color 0.3s;
  }
  .field textarea {
    resize: vertical;
  }
  .field input::placeholder {
    color: rgb(94 79 57 / 0.6);
    font-style: italic;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--lavender-deep);
    background: rgb(255 251 240 / 0.75);
  }

  .choice {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .choice legend {
    grid-column: 1 / -1;
    margin-bottom: 6px;
  }
  .choice__opt {
    position: relative;
    cursor: pointer;
  }
  .choice__opt input {
    position: absolute;
    opacity: 0;
  }
  .choice__opt span {
    display: grid;
    gap: 2px;
    height: 100%;
    padding: 14px 14px 12px;
    border: 1.5px solid rgb(51 40 26 / 0.3);
    background: rgb(255 251 240 / 0.35);
    transition:
      border-color 0.3s,
      background-color 0.3s,
      box-shadow 0.3s;
  }
  .choice__opt strong {
    font-family: var(--display);
    font-weight: 400;
    font-size: 1rem;
    letter-spacing: 0.04em;
  }
  .choice__opt em {
    font-size: 0.98rem;
    color: var(--ink-soft);
  }
  .choice__opt input:checked + span {
    border-color: var(--lavender-deep);
    background: rgb(155 140 198 / 0.18);
    box-shadow: inset 0 0 0 1px var(--lavender-deep);
  }
  .choice__opt input:focus-visible + span {
    outline: 2px solid var(--lavender-deep);
    outline-offset: 2px;
  }

  .field--guests.is-hidden {
    display: none;
  }
  .stepper {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
  }
  .stepper button {
    width: 44px;
    height: 44px;
    border: 1.5px solid rgb(51 40 26 / 0.35);
    border-radius: 50%;
    background: rgb(255 251 240 / 0.4);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }
  .stepper button:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .stepper output {
    min-width: 2.2em;
    text-align: center;
    font-family: var(--display);
    font-size: 1.4rem;
  }

  .rsvp__send {
    justify-self: center;
    margin-top: 6px;
    min-width: 220px;
  }
  .rsvp__error {
    text-align: center;
    color: #8b2a1b;
    font-style: italic;
  }

  .rsvp__done {
    margin-top: 30px;
    text-align: center;
  }
  .rsvp__done:focus {
    outline: none;
  }
  .rsvp__done-title {
    font-family: var(--display);
    font-size: clamp(1.5rem, 4vw, 2rem);
  }
  .rsvp__done-text {
    margin: 10px auto 0;
    max-width: 36ch;
    font-size: 1.15rem;
    font-style: italic;
    color: var(--ink-soft);
  }

  .rsvp__stamp {
    width: 104px;
    height: 104px;
    margin: 22px auto 0;
    opacity: 0;
    pointer-events: none;
    filter: drop-shadow(0 6px 10px rgb(20 10 30 / 0.45));
  }

  @media (max-width: 520px) {
    .choice {
      grid-template-columns: 1fr;
    }
  }
</style>
